{
  "manifest_version": 3,
  "name": "Spectra Capture",
  "short_name": "Spectra Capture",
  "version": "0.7.1",
  "description": "Save a picture of a web page at any size or aspect ratio. Runs on your computer.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Spectra Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "offscreen",
    "storage",
    "notifications",
    "tabs",
    "clipboardWrite"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
